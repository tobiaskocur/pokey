<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>@PREFIX@.ui</string>
	<key>BundleProgram</key><string>Contents/Helpers/Pokey Alerts.app/Contents/MacOS/Pokey Alerts</string>
	<key>AssociatedBundleIdentifiers</key><array><string>@PREFIX@.host</string></array>
	<key>LimitLoadToSessionType</key><array><string>Aqua</string></array>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><true/>
	<key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
