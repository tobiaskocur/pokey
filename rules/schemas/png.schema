# PNG: signature, IHDR first, every chunk length/CRC checked, IDAT present,
# nothing after IEND (trailing data is the classic polyglot carrier).
schema png
detect at 0 hex"89504E470D0A1A0A"
endian big

main {
  expect hex"89504E470D0A1A0A" "missing PNG signature"
  field len u32
  require len == 13 "IHDR length must be 13"
  expect hex"49484452" "first chunk must be IHDR"
  field width u32
  field height u32
  require width > 0 && height > 0 "zero image dimension"
  require width <= 0x7fffffff && height <= 0x7fffffff "image dimension exceeds 2^31-1"
  field depth u8
  field ctype u8
  require ctype == 0 || ctype == 2 || ctype == 3 || ctype == 4 || ctype == 6 "invalid colour type"
  require depth == 1 || depth == 2 || depth == 4 || depth == 8 || depth == 16 "invalid bit depth"
  field compression u8
  field filter u8
  field interlace u8
  require compression == 0 && filter == 0 && interlace <= 1 "invalid IHDR method"
  field crc u32
  require crc == crc32(12, 17) "IHDR CRC mismatch"

  let done = 0
  let idat = 0
  let chunks = 0
  while done == 0 {
    require end - pos >= 12 "truncated chunk or missing IEND"
    let start = pos
    field len u32
    require len <= 0x7fffffff "chunk length exceeds 2^31-1"
    require len + 8 <= end - pos "chunk extends past end of file"
    field type u32
    skip len
    field crc u32
    require crc == crc32(start + 4, len + 4) "chunk CRC mismatch"
    require type != fourcc"IHDR" "duplicate IHDR"
    let chunks = chunks + 1
    require chunks <= 100000 "too many chunks"
    if type == fourcc"IDAT" {
      let idat = 1
    } else if type == fourcc"IEND" {
      require len == 0 "IEND must be empty"
      let done = 1
    }
  }
  require idat == 1 "no IDAT chunk"
  require pos == end "data after IEND"
}
